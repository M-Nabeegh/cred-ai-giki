# Where customer data comes from. "synthetic" (default) needs nothing else.
CREDAI_DATA_PROVIDER=synthetic

# For CREDAI_DATA_PROVIDER=http — any service implementing the data contract
# (see /developers or src/lib/core/schema.ts).
# CREDAI_DATA_API_URL=https://data.your-bank.example/v1
# CREDAI_DATA_API_KEY=
# CREDAI_DATA_REVALIDATE=60
